{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "monitor.json",
  "type": "object",
  "required": [
    "run_id",
    "as_of_utc",
    "git_sha",
    "model_card_hash",
    "market_date",
    "mode",
    "risk_label_changes",
    "new_structural_breaks",
    "data_gaps",
    "opportunity_flags"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "as_of_utc": {
      "type": "string"
    },
    "git_sha": {
      "type": "string"
    },
    "model_card_hash": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "full",
        "monitor_only"
      ]
    },
    "opportunity_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "class"
        ],
        "properties": {
          "class": {
            "const": "OPPORTUNITY"
          }
        }
      }
    }
  }
}
